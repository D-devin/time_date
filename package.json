{
  "name": "desktop-planner-core",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "时笺 · Windows 桌面悬浮日程表",
  "productName": "时笺",
  "main": "dist/src/desktop/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-desktop-assets.mjs",
    "start": "npm run build && electron .",
    "desktop:demo": "npm run build && electron . --demo",
    "package:win": "npm run build && electron-builder --config electron-builder.json --win --x64 --publish never && node scripts/copy-release.mjs",
    "test:desktop": "npm run build && node scripts/desktop-smoke.mjs",
    "test:portable": "node scripts/portable-smoke.mjs",
    "test:journal": "npm run build && node scripts/journal-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "demo": "npm run build && node dist/scripts/demo.js",
    "cli": "npm run build && node dist/scripts/cli.js"
  },
  "dependencies": {
    "koffi": "3.3.6",
    "write-file-atomic": "8.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/sortablejs": "1.15.9",
    "@types/write-file-atomic": "4.0.3",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "playwright-core": "1.64.1",
    "sortablejs": "1.15.7",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
